<Window x:Class="PIKATWEAKS2.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PIKATWEAKS2" Width="1320" Height="820" MinWidth="1100" MinHeight="700" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0D0915" BorderBrush="#21172E" BorderThickness="0,0,1,0">
   <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="4,8,0,24">
        <Border Width="38" Height="38" CornerRadius="11" Background="#6D28D9"><TextBlock Text="P" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Margin="10,0,0,0"><TextBlock Text="PIKATWEAKS2" FontWeight="Bold" FontSize="17"/><TextBlock Text="Windows Optimizer" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
      </StackPanel>
      <Button x:Name="HomeButton" Content="⌂   Dashboard" Click="Home_Click" HorizontalContentAlignment="Left"/>
      <Button Content="⚡   Tweaks" Click="Tweaks_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🎮   Gaming" Click="Gaming_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🧹   Cleanup" Click="Cleanup_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🌐   Network" Click="Network_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🛡   Privacy" Click="Privacy_Click" HorizontalContentAlignment="Left"/>
      <Button Content="⚙   Services" Click="Services_Click" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <Separator Margin="0,8" Background="#2A1B3B"/>
      <Button Content="💾   Backup" Click="Backup_Click" HorizontalContentAlignment="Left"/>
      <Button Content="↩   Restore" Click="Restore_Click" HorizontalContentAlignment="Left"/>
      <TextBlock x:Name="AdminText" Text="● Administrator" Foreground="#C084FC" FontSize="11" Margin="12,14,0,4"/>
      <TextBlock Text="PIKATWEAKS2 • V1" Foreground="#625A70" FontSize="10" Margin="12,0,0,4"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1" Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,4,0,20">
    <StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Tune Windows without a command window." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="↻ Refresh" Click="Refresh_Click"/>
      <Button Content="⚡ Optimize" Background="#7C3AED" BorderBrush="#A855F7" Click="Optimize_Click"/>
    </StackPanel>
   </Grid>

   <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="TWEAKS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TweakCount" Text="75" FontSize="28" FontWeight="Bold"/><TextBlock Text="source-derived actions" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="14" Margin="10,0" Padding="18"><StackPanel><TextBlock Text="RECOMMENDED" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="RecommendedCount" Text="0" FontSize="28" FontWeight="Bold"/><TextBlock Text="safe optimize actions" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Margin="10,0" Padding="18"><StackPanel><TextBlock Text="CPU THREADS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuCount" Text="-" FontSize="28" FontWeight="Bold"/><TextBlock Text="logical processors" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
    <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="14" Margin="10,0,0,0" Padding="18"><StackPanel><TextBlock Text="STATUS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="StatusCard" Text="Ready" FontSize="23" FontWeight="Bold"/><TextBlock Text="administrator mode" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
   </Grid>

   <Grid Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="12" Background="#100B18" Foreground="White" BorderBrush="#2D2140" TextChanged="Search_TextChanged" ToolTip="Search tweaks"/>
      <ComboBox x:Name="CategoryBox" Grid.Column="1" Height="38" Margin="10,0" SelectionChanged="Category_Changed"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Select All" Click="SelectAll_Click"/><Button Content="Clear" Click="Clear_Click"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="10">
      <ListBox x:Name="TweakList" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Border Background="#100B18" CornerRadius="10" Margin="3" Padding="12">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
           <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
           <Border Grid.Column="2" Background="#1B1228" CornerRadius="7" Padding="8,4" Margin="8,0"><TextBlock Text="{Binding Category}" HorizontalAlignment="Center" Foreground="#D8B4FE" FontSize="11"/></Border>
           <TextBlock Grid.Column="3" Text="✓ Recommended" Foreground="#C084FC" FontSize="10" VerticalAlignment="Center" Visibility="{Binding RecommendedVisibility}"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
    </Border>
   </Grid>

   <Grid Grid.Row="3" Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#0E0A15" BorderBrush="#21172E" BorderThickness="1" CornerRadius="12" Padding="12">
      <DockPanel><TextBlock Text="ACTIVITY" Foreground="#C4B5FD" FontWeight="Bold" DockPanel.Dock="Top" Margin="2,0,0,8"/><ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="#B8B0C7" FontSize="11"/></DockPanel>
    </Border>
    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
      <Button Content="Apply Selected" Width="150" Height="42" Click="ApplySelected_Click" Background="#7C3AED" BorderBrush="#A855F7"/>
      <Button Content="Apply Recommended" Width="150" Click="Optimize_Click"/>
      <Button Content="Apply All Non-Maintenance" Width="150" Click="ApplyAll_Click"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
