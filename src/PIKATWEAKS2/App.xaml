<Application x:Class="PIKATWEAKS2.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#09070F"/>
    <SolidColorBrush x:Key="Panel" Color="#120D1C"/>
    <SolidColorBrush x:Key="Panel2" Color="#181125"/>
    <SolidColorBrush x:Key="Purple" Color="#A855F7"/>
    <SolidColorBrush x:Key="Purple2" Color="#7C3AED"/>
    <SolidColorBrush x:Key="Text" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="Muted" Color="#A9A2B8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="#2D2140"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="2"/></Style>
  </Application.Resources>
</Application>
